# Public URL of your deployed app (required for CORS)
CLIENT_ORIGIN=https://ux-study.example.de
APP_DOMAIN=ux-study.example.de
ACME_EMAIL=you@example.de

# MongoDB connection inside docker network
MONGO_URI=mongodb://mongo:27017/ux_research_app

# Strong secret (at least 32+ random chars)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Only needed for first admin bootstrap flow
ADMIN_BOOTSTRAP_KEY=change-this-admin-bootstrap-key
